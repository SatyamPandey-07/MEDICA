# ============================================================
# MEDICA — Environment Configuration
# Copy to .env and fill in your values.
# IMPORTANT: Do NOT put inline comments after values (e.g. FOO=bar # comment).
#            dotenv parsers treat everything after the = as the value,
#            which breaks enum fields like LLM_PROVIDER.
# ============================================================

# --- Database ---
POSTGRES_USER=medica
POSTGRES_PASSWORD=medica_secret
POSTGRES_DB=medica
DATABASE_URL=postgresql+asyncpg://medica:medica_secret@localhost:5432/medica
DATABASE_URL_SYNC=postgresql+psycopg2://medica:medica_secret@localhost:5432/medica

# --- LLM Provider ---
# Options: gemini | openai | anthropic | groq
LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq (free, ultra-fast)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Embedding Provider ---
# Options: local | gemini | openai
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2      # local (384 dims)
# EMBEDDING_MODEL=text-embedding-004    # gemini (768 dims)
# EMBEDDING_MODEL=text-embedding-3-small # openai (1536 dims)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- PubMed / NCBI ---
# Optional: NCBI_API_KEY increases rate limit from 3 to 10 req/s
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# --- Knowledge Base ---
KNOWLEDGE_BASE_PATH=./knowledge

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# --- App ---
# Options: development | production
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_long_random_string
LOG_LEVEL=INFO

# --- Scheduler ---
SCHEDULER_ENABLED=true
DAILY_FETCH_HOUR=2
WEEKLY_OPTIMIZE_DAY=sun

# --- Rate Limiting (requests per second) ---
PUBMED_RATE_LIMIT=3
CROSSREF_RATE_LIMIT=5
SEMANTIC_SCHOLAR_RATE_LIMIT=5

# --- Ingestion Agent Specifics ---
# Format: sqlite+aiosqlite:///./oncology.db
DATABASE_URL=sqlite+aiosqlite:///./oncology.db
NCBI_TOOL_NAME=oncology_agent
POLLING_INTERVAL=60

