# ============================================================
# MEDICA — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Database ---
POSTGRES_USER=medica
POSTGRES_PASSWORD=medica_secret
POSTGRES_DB=medica
DATABASE_URL=postgresql+asyncpg://medica:medica_secret@localhost:5432/medica
DATABASE_URL_SYNC=postgresql+psycopg2://medica:medica_secret@localhost:5432/medica

# --- LLM Provider (choose one) ---
LLM_PROVIDER=gemini  # Options: gemini | openai | anthropic

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Embedding Provider ---
EMBEDDING_PROVIDER=local  # Options: local | gemini | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2  # Used when provider=local
# EMBEDDING_MODEL=text-embedding-004   # Used when provider=gemini
# EMBEDDING_MODEL=text-embedding-3-small  # Used when provider=openai
EMBEDDING_DIMENSIONS=384  # 384 for MiniLM, 768 for Gemini, 1536 for OpenAI small

# --- PubMed / NCBI ---
NCBI_API_KEY=your_ncbi_api_key_here  # Optional: increases rate limit to 10 req/s
NCBI_EMAIL=your_email@example.com    # Required by NCBI policy

# --- Knowledge Base ---
KNOWLEDGE_BASE_PATH=./knowledge

# --- App ---
ENVIRONMENT=development  # development | production
SECRET_KEY=change_this_to_a_long_random_string
LOG_LEVEL=INFO

# --- Scheduler ---
SCHEDULER_ENABLED=true
DAILY_FETCH_HOUR=2    # Run daily fetch at 2 AM
WEEKLY_OPTIMIZE_DAY=sun  # Run weekly optimization on Sunday

# --- Rate Limiting ---
PUBMED_RATE_LIMIT=3      # Requests per second (10 with API key)
CROSSREF_RATE_LIMIT=5
SEMANTIC_SCHOLAR_RATE_LIMIT=5
